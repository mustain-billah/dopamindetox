# Copy to .env next to manage.py. Real environment variables override this file.

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required behind an HTTPS proxy, or every login fails a CSRF check.
# In production: https://dopamindetox.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dopamindetox.pythonanywhere.com

DJANGO_TIME_ZONE=Asia/Dhaka

# The challenge itself
CHALLENGE_NAME=Dopamine Detox
CHALLENGE_START=2026-09-11
CHALLENGE_END=2027-01-11
CHALLENGE_PRIZE=10,000
